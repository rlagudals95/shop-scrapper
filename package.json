{
  "name": "commerce-crawler",
  "version": "1.0.0",
  "description": "AI 기반 자가 복구 크롤링 프레임워크 - Gemini AI를 활용한 스마트 XPath 관리",
  "main": "dist/main.js",
  "bin": {
    "commerce-crawler": "./dist/main.js"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:unit:domain": "jest --testPathPattern=test/unit/domain",
    "test:unit:infra": "jest --testPathPattern=test/unit/infrastructure",
    "test:domain:analyzer": "jest --testPathPattern=analyzer.service",
    "test:domain:extractor": "jest --testPathPattern=extractor.service",
    "test:domain:validator": "jest --testPathPattern=validator.service",
    "test:infra:db": "jest --testPathPattern=xpath-cache.repository",
    "test:infra:browser": "jest --testPathPattern=playwright.client",
    "test:infra:ai": "jest --testPathPattern=gemini.client",
    "test:integration": "jest --testPathPattern=test/integration",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:coupang": "jest --testPathPattern=test/unit/coupang --verbose",
    "test:coupang:real": "jest --testPathPattern=real-ai-pipeline --verbose",
    "test:coupang:pipeline:mock": "jest --testPathPattern=coupang-pipeline-mock --verbose",
    "test:local:html:ai:pipeline": "jest --testPathPattern=local-html-ai-pipeline --verbose",
    "test:coupang:proxy": "rm -rf data/browser-profile-coupang && PROXY_ENABLED=true jest --testPathPattern=coupang-browser-client --no-coverage --runInBand",
    "test:coupang:proxy:legacy": "rm -rf data/browser-profile-proxy && PROXY_ENABLED=true jest --testPathPattern=residential-proxy-test --no-coverage --runInBand"
  },
  "keywords": [
    "crawler",
    "scraper",
    "ai",
    "gemini",
    "xpath",
    "e-commerce",
    "nestjs",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.3.0",
    "cheerio": "^1.1.2",
    "cli-table3": "^0.6.5",
    "nest-commander": "^3.15.0",
    "ora": "^9.0.0",
    "playwright": "^1.49.1",
    "playwright-extra": "^4.3.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "xmldom": "^0.6.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@jest/test-sequencer": "^29.7.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cheerio": "^0.22.35",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/xmldom": "^0.1.34",
    "dotenv": "^17.2.3",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/main.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@exodus/bytes)/)"
    ],
    "setupFiles": [
      "dotenv/config"
    ]
  }
}
